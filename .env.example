# -----------------------------------------------------------------------------
# Hugging Face access
# -----------------------------------------------------------------------------
HUGGINGFACEHUB_API_TOKEN1=your_huggingface_read_token_1
HUGGINGFACEHUB_API_TOKEN2=your_huggingface_read_token_2
HUGGINGFACEHUB_API_TOKEN3=your_huggingface_read_token_3
HUGGINGFACEHUB_API_TOKEN4=your_huggingface_read_token_4
HUGGINGFACEHUB_API_TOKEN5=your_huggingface_read_token_5

# -----------------------------------------------------------------------------
# Model / LLM settings
# -----------------------------------------------------------------------------
LLM_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
HF_PROVIDER=auto
LLM_MAX_NEW_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_CALL_DELAY_SECONDS=20
MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Embedding / storage settings
# -----------------------------------------------------------------------------
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_CACHE_DIR=.models
EMBEDDING_LOCAL_FILES_ONLY=false
CHROMA_DIR=.chroma
DOCUMENTS_DIR=documents

# -----------------------------------------------------------------------------
# RAG tuning
# -----------------------------------------------------------------------------
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=140
RAG_EMBEDDING_BATCH_SIZE=16
RAG_TOP_K=8
RAG_CANDIDATE_MULTIPLIER=6
CROSS_ENCODER_MODEL_ID=BAAI/bge-reranker-v2-m3
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_BATCH_SIZE=8
CROSS_ENCODER_LOCAL_FILES_ONLY=false
CROSS_ENCODER_CACHE_DIR=.models
RAG_DENSE_WEIGHT=0.35
RAG_BM25_WEIGHT=0.25
CROSS_ENCODER_WEIGHT=0.40
MAX_RESEARCH_ITERATIONS=2
